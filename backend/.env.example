FLASK_APP=app.py
FLASK_ENV=production
PORT=5000

# Clerk JWKS URL for JWT signature validation
CLERK_JWKS_URL=https://<your_clerk_app_id>.clerk.accounts.dev/.well-known/jwks.json

# Pinecone Vector Database Configs
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-hr-assistant-index

# OpenRouter API Key for RAG LLM generation
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
APP_URL=https://your-frontend-deployment.vercel.app
